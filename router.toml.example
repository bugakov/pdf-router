# router.toml.example — template for the real router.toml (which is gitignored).
#
# Copy to router.toml, uncomment the sections you need, fill in the values:
#   cp router.toml.example router.toml && chmod 600 router.toml
#
# Rules:
# - Precedence: CLI flag > this file > built-in defaults.
# - No env-var lookups for keys — this file is the single source of truth.
# - OCR model: [ocr.<engine>] sections STORE engine params; exactly ONE
#   engine runs, picked by [routing].ocr_fallback_engine. Sections of
#   unselected engines are validated but otherwise ignored — keep keys for
#   several engines and switch by changing one line.
# - Fail fast at load: an unknown ocr_fallback_engine name, or a selected
#   engine without its [ocr.*] section, is a ConfigError before any page is
#   processed. rapidocr is exempt — it needs no section at all.

# --- RapidOCR (default) — CPU via onnxruntime, no keys -----------------------
# Models auto-download from ModelScope on first run, then fully offline.
# No required keys: an absent section means built-in defaults.
#[ocr.rapidocr]
## optional:
## dpi = 150                 # 100 hallucinates; 200+ slower, no quality gain
## det_model_type = "small"  # tiny/small/medium/server variants exist
## rec_model_type = "mobile" # eslav (Cyrillic) head only ships as mobile

[router]
log_level = "info"          # debug | info | warning | error; default "warning"

# --- Native OCR (PP-OCRv6 via pdf-inspector) — CPU-only, no keys -------------
# Requires the pdfium + onnxruntime shared libraries on this host.
#[ocr.pdf_inspector_ocr]
#pdfium_lib_path = "/abs/path/libpdfium.so"
#ort_dylib_path = "/abs/path/libonnxruntime.so"
## optional:
## model_cache_dir = "~/.cache/pdf-router/models"
## offline = false

# --- Tesseract — local binary, no keys ---------------------------------------
# Requires the [tesseract] extra: uv sync --extra tesseract
#[ocr.tesseract]
#languages = ["rus", "eng"]
## optional:
## bin = "/usr/bin/tesseract"
## dpi = 200

# --- GLM-OCR (z.ai) — cloud, API key -------------------------------------------
# Requires the [cloud] extra: uv sync --extra cloud
# Dedicated glm-ocr model via layout_parsing on the standard endpoint;
# the page goes inline as a single-page PDF (base64) — no third-party host.
#[ocr.glm_ocr]
#api_key = "sk-..."                   # NOT via env, by design
#base_url = "https://api.z.ai/api/paas/v4"
##   coding-plan keys get 429 "Insufficient balance" here — use a key
##   with the document package (e.g. ZAI_API_KEY).
## optional:
## model = "glm-ocr"                 # dedicated document model (default)
## timeout = 300

# --- deepseek-ocr-2 (Novita AI) — cloud, API key ------------------------------
# Requires the [cloud] extra: uv sync --extra cloud
#[ocr.deepseek_ocr]
#api_key = "sk-..."
#base_url = "https://api.novita.ai/openai"
#model = "deepseek/deepseek-ocr-2"
## optional:
## upload_url = "https://uguu.se/upload"     # default; 48h retention.
##   catbox.moe is BLOCKED from this host (412 "Invalid uploader", IP-wide);
##   if you switch, the adapter auto-detects field names per host.
## prompt = "OCR this image."                # terse prompt; the markdown-style
##   prompt triggers repetition loops on dense drawing pages (live-tested).
## timeout = 60
## max_tokens = 4096
## dpi = 200

[renderers]
# Which renderers run is chosen via --render (CLI only); default: all three.
# output_dir = "out/"   # default: ./out/
# page_markers = true   # insert <!-- page N --> in md renderer; default false
[renderers.chunks]
# max_tokens = 512      # default
# overlap_tokens = 64   # default
[renderers.json]
# include_page_bbox = false  # default; opt-in

[routing]
# Language hint for looks_like_text. When set, only characters from that
# language's Unicode range count toward the alpha ratio.
# Supported: "ru" (Cyrillic). Default: null (any language).
#language = "ru"

# Minimum fraction of alphabetic characters in the page text to consider it
# "real text" and skip OCR fallback. Default: 0.30.
# Calibrated on 3 PDFs / 46 pages: 0 false negatives at every threshold.
# See TKT-RT-11.
#text_alpha_threshold = 0.30

# Number of parallel workers for page processing (text + images). Default: 2.
#workers = 2

# Extract raster photos (embedded JPEG/PNG). Filters page-background scans
# (images covering >= 80% of page area). Default: true.
#extract_raster_photos = true

# Extract vector diagrams (drawn paths) rendered as PNG. Default: false.
#extract_vector_diagrams = false

# Which OCR engine to call when looks_like_text fails. Must be a known
# engine name and have a matching [ocr.*] section (rapidocr needs none).
# Default: "rapidocr".
# Supported: "rapidocr" (CPU via onnxruntime, models auto-downloaded),
#            "pdf_inspector_ocr" (PP-OCRv6 Small via pdf-inspector Rust),
#            "tesseract" (local, requires tesseract binary),
#            "glm_ocr" (cloud, requires api_key),
#            "deepseek_ocr" (cloud, requires api_key).
#ocr_fallback_engine = "rapidocr"

# Engine params live in the [ocr.<engine>] sections above, not here —
# one source of params per engine. Required keys per engine are checked
# when this file is loaded.
#   rapidocr:          dpi, det_model_type, rec_model_type
#   pdf_inspector_ocr: pdfium_lib_path, ort_dylib_path (required);
#                      dpi, minimum_confidence, offline, model_cache_dir
#   tesseract:         languages (required); bin, dpi
#   glm_ocr:           api_key, base_url (required); model, timeout
#   deepseek_ocr:      api_key, base_url (required); model, upload_url,
#                      prompt, timeout, max_tokens, dpi
